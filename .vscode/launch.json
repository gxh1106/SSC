{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "My Debug",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ssc/train.py",
      "console": "integratedTerminal",
      "args": [
        
      ],
      "env": {
        "CUDA_VISIBLE_DEVICES": "0"
      }
    },
    {
      "name": "DDP Debug",
      "type": "debugpy",
      "request": "launch",
      "module": "torch.distributed.run", // 使用 torch.distributed.run 模块
      "console": "integratedTerminal",
      "args": [
        "--nproc_per_node=1",
        "--nnodes=1",
        "--node_rank=0",
        "--master_addr=localhost", // 通常本地调试设为 localhost
        "--master_port=29499",     // 选择一个未被占用的端口
        "${workspaceFolder}/ssc/train.py",
        "-opt",
        "options/Ke/train_SSC_96C_16E_4D_Ke4_from_pretrain.yml",
        "--launcher",
        "pytorch",
        "--debug"
      ],
      "env": {
        // 如果需要，可以在这里设置环境变量
        "CUDA_VISIBLE_DEVICES": "0"
      }
    },
    {
      "name": "Infer Debug",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ssc/inference.py",
      "console": "integratedTerminal",
      "args": [
        "--config",
        "experiments/train_MVQ_bbp2_32C_4V_65536E/train_MVQ_bpp2_32C_4V_65536E_from_pretrain.yml",
        "--model_path",
        "experiments/train_MVQ_bbp2_32C_4V_65536E/models/net_g_5000.pth",
        "--input",
        "datasets/Kodak24",
        "--output",
        "output/baseline/bpp2_32C_16E_4D/MVQ_4V_65536E_debug"
      ],
      "env": {
        // 如果需要，可以在这里设置环境变量
        "CUDA_VISIBLE_DEVICES": "3"
      }
    }
  ]
  
}
